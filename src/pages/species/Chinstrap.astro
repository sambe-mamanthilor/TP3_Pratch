---
import GraphicSpecies from "../../components/GraphicSpecies.astro";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Espèce Chinstrap</title>
  </head>
  <body class="p-8">
    <label for="species" class="block mb-2 font-medium">Choisir l'espèce :</label>
    <select id="species" class="p-2 border rounded border-gray-300 mb-6">
      <option value="Adelie">Adelie</option>
      <option value="Chinstrap" selected>Chinstrap</option>
      <option value="Gentoo">Gentoo</option>
    </select>

    <h1 class="text-2xl font-bold mb-4">Chinstrap</h1>
    <GraphicSpecies species="Chinstrap" />

    <script>
      document.querySelector("#species")?.addEventListener("change", (evt) => {
        const value = (evt.target as HTMLSelectElement).value;
        location.pathname = "/species/" + value + "/";
      });
    </script>
  </body>
</html>