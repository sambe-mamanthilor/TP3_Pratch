---
import GraphicSpecies from "../components/GraphicSpecies.astro";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>TP3 - Slider et Ancres avec Select</title>
  </head>
  <body class="p-8">
    <header class="sticky top-0 bg-white p-4 shadow-md z-10 mb-6">
      <label for="species-anchor" class="mr-2 font-medium">Naviguer vers l'espèce :</label>
      <select id="species-anchor" class="p-2 border rounded border-gray-300">
        <option value="adelie">Adelie</option>
        <option value="gentoo">Gentoo</option>
        <option value="chinstrap">Chinstrap</option>
      </select>
    </header>

    <!-- Slider horizontal CSS -->
    <main class="slider flex overflow-x-auto snap-x snap-mandatory gap-8 pb-8">
      <section id="adelie" class="item min-w-full snap-center bg-gray-50 p-6 rounded-lg shrink-0">
        <h2 class="text-xl font-bold mb-4">Adelie</h2>
        <GraphicSpecies species="Adelie" />
      </section>

      <section id="gentoo" class="item min-w-full snap-center bg-gray-50 p-6 rounded-lg shrink-0">
        <h2 class="text-xl font-bold mb-4">Gentoo</h2>
        <GraphicSpecies species="Gentoo" />
      </section>

      <section id="chinstrap" class="item min-w-full snap-center bg-gray-50 p-6 rounded-lg shrink-0">
        <h2 class="text-xl font-bold mb-4">Chinstrap</h2>
        <GraphicSpecies species="Chinstrap" />
      </section>
    </main>

    <script>
      document.querySelector("#species-anchor")?.addEventListener("change", (evt) => {
        const value = (evt.target as HTMLSelectElement).value;
        location.hash = "#" + value;
      });
    </script>

    <style>
      .slider {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
      }
      .item {
        flex: 0 0 100%;
        scroll-snap-align: center;
      }
    </style>
  </body>
</html>